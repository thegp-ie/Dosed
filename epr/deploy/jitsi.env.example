# Settings for the official docker-jitsi-meet stack (github.com/jitsi/docker-jitsi-meet),
# added to its .env. Run it on an EU server you control (it can share the EPR host).
# JWT auth means only links issued by the EPR open a room.
ENABLE_AUTH=1
AUTH_TYPE=jwt
JWT_APP_ID=epr                 # = EPR_JITSI_APP_ID
JWT_APP_SECRET=                # = EPR_JITSI_APP_SECRET
JWT_ACCEPTED_ISSUERS=epr
JWT_ACCEPTED_AUDIENCES=jitsi
ENABLE_GUESTS=0
ENABLE_LOBBY=1                 # patient waits until the clinician admits them
ENABLE_PREJOIN_PAGE=1
ENABLE_RECORDING=0             # no recording; keep off unless separately agreed and lawful
ENABLE_TRANSCRIPTIONS=0
DISABLE_THIRD_PARTY_REQUESTS=1 # no gravatar/callstats/etc.
ENABLE_LETSENCRYPT=1
PUBLIC_URL=https://meet.yourpractice.ie
