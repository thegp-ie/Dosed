# Copy to .env and fill in. Generate keys with:  docker compose run --rm app python -m app.cli gen-keys
# Keep .env out of git and backups of it separate from database backups.
EPR_DOMAIN=epr.yourpractice.ie
EPR_PUBLIC_BASE_URL=https://epr.yourpractice.ie
POSTGRES_PASSWORD=change-me

EPR_DATA_KEY=
EPR_INDEX_KEY=
EPR_SECRET_KEY=

EPR_PRACTICE_NAME=Your Medical Centre
EPR_PRACTICE_ADDRESS=1 Main Street, Town, Co. County, A65 F4E2
EPR_HEALTHLINK_PRACTICE_ID=

EPR_REQUIRE_MFA=true
EPR_SESSION_IDLE_MINUTES=15

# Healthlink: "directory" (file bridge) or "disabled"
EPR_HEALTHLINK_MODE=directory
EPR_HEALTHLINK_POLL_SECONDS=300

# Healthmail: host names and ports from the HSE Healthmail onboarding pack
EPR_HEALTHMAIL_SMTP_HOST=
EPR_HEALTHMAIL_SMTP_PORT=587
EPR_HEALTHMAIL_IMAP_HOST=
EPR_HEALTHMAIL_IMAP_PORT=993
EPR_HEALTHMAIL_ALLOWED_DOMAINS=healthmail.ie,hse.ie

# Remote consultations: your self-hosted Jitsi Meet (JWT auth). See deploy/jitsi.env.example
EPR_JITSI_BASE_URL=https://meet.yourpractice.ie
EPR_JITSI_APP_ID=epr
EPR_JITSI_APP_SECRET=

# AI scribe (optional). Both services must run on practice-controlled servers in the EEA.
# Speech-to-text: self-hosted Whisper server endpoint taking multipart "file", returning {"text": ...}
EPR_STT_URL=
EPR_STT_MODEL=whisper-large-v3
# Note drafting: self-hosted Ollama server and the model you have evaluated
EPR_LLM_URL=
EPR_LLM_MODEL=
EPR_SCRIBE_RETAIN_DAYS=0

# ICD-11 search via WHO's locally deployable ICD-API container (optional)
EPR_ICD_API_URL=
EPR_ICD11_RELEASE=2025-01
